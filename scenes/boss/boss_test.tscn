[sub_resource type="Shader" id="Shader_ground"]
code = "shader_type spatial;
// dusty checker so you can read speed and distance in the sandbox
varying vec3 world_pos;
void vertex() { world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz; }
void fragment() {
	vec2 cell = floor(world_pos.xz / 8.0);
	float checker = mod(cell.x + cell.y, 2.0);
	ALBEDO = mix(vec3(0.43, 0.38, 0.29), vec3(0.37, 0.33, 0.25), checker);
	ROUGHNESS = 0.95;
}
"

